;; Apple MTP keyboard only. Caps Lock is Escape on tap and Control while held.
;; Right Option emits F9 for the Voxtype Globe tap/hold binding.
(defcfg
  linux-dev /dev/input/by-path/platform-24eb30000.input-event-kbd
  process-unmapped-keys yes
)

(defsrc caps ralt)

(deflayer base
  (tap-hold-press 200 200 esc lctl)
  f9
)
